# Vite base path: / for domain root; /your-subpath for subpath deployment.
VITE_BASE_PATH=/

# Axios base URL. Business API modules must not hardcode this value.
VITE_API_BASE_URL=/api

# Optional explicit override. When omitted, development defaults to enabled and production defaults to disabled.
# MSW worker and handlers are added in the data/API implementation phase.
# VITE_ENABLE_MSW=true
